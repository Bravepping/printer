<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ping.mapper.PrintJobMapper">

    <resultMap id="BaseResultMap" type="com.ping.pojo.PrintJob">
            <id property="id" column="id" />
            <result property="userId" column="user_id" />
            <result property="filesId" column="files_id" />
            <result property="startTime" column="start_time" />
            <result property="endTime" column="end_time" />
            <result property="page" column="page" />
            <result property="count" column="count" />
            <result property="isDouble" column="is_double" />
            <result property="printerName" column="printer_name" />
            <result property="status" column="status" />
    </resultMap>

    <resultMap id="PrintsVo" type="com.ping.model.vo.PrintsVo">
        <id property="id" column="id" />
        <result property="filesId" column="files_id" />
        <result property="fileName" column="file_name" />
        <result property="startTime" column="start_time" />
        <result property="endTime" column="end_time" />
        <result property="page" column="page" />
        <result property="count" column="count" />
        <result property="isDouble" column="is_double" />
        <result property="printerName" column="printer_name" />
        <result property="status" column="status" />
        <result property="isLive" column="is_live" />
    </resultMap>

    <resultMap id="AllPrintsVo" type="com.ping.model.vo.AdminPrintsVo">
        <id property="id" column="id" />
        <result property="fileName" column="file_name" />
        <result property="userName" column="username" />
        <result property="startTime" column="start_time" />
        <result property="endTime" column="end_time" />
        <result property="page" column="page" />
        <result property="count" column="count" />
        <result property="isDouble" column="is_double" />
        <result property="printerName" column="printer_name" />
        <result property="status" column="status" />
        <result property="isLive" column="is_live" />
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,files_id,start_time,end_time,page,
        count,is_double,printer_name,status,is_live
    </sql>

    <select id="getPrintJobsByUserIdMapper" resultMap="PrintsVo">
        select p.*,p.files_id,f.file_name
        from print_job p inner join files f
        on p.files_id = f.id
        where p.user_id = #{userId}
        order by p.id desc
    </select>

    <select id="getAllPrintJobsIdMapper" resultType="com.ping.model.vo.AdminPrintsVo">
        SELECT
        p.*,
        u.username,
        f.file_name
        FROM
        print_job p
        LEFT JOIN
        user u ON p.user_id = u.id
        LEFT JOIN
        files f ON p.files_id = f.id
        <where>
            <if test="type == -1">
                AND p.is_live = 0
            </if>
            <if test="type == 0">
                AND p.status = '待打印'
            </if>
        </where>
        ORDER BY p.start_time DESC
    </select>

    <select id="getPrintJobStatusStatistics" resultType="java.util.Map">
        SELECT
            p.status,
            COUNT(*) as count
        FROM
            print_job p
            LEFT JOIN
            user u ON p.user_id = u.id
        <!-- WHERE
            u.role != 3-->
        GROUP BY
            p.status
    </select>

    <select id="getAllWaitReviewCount" resultType="java.lang.Integer">
        SELECT count(*)
        FROM print_job p
                 INNER JOIN user u ON p.user_id = u.id
        WHERE p.is_live = 0 <!--AND u.role != 3 -->
    </select>

    <select id="getCountByUserId" resultType="int">
        select count(*)
        from print_job
        where user_id = #{userId}
    </select>

    <select id="getWaitReviewCount" resultType="int">
        select count(*)
        from print_job
        where user_id = #{userId}
        and is_live = 0
    </select>

</mapper>
